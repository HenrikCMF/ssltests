Bootstrap: docker
From: ubuntu:24.04

%files
    # Copy the pinned dependency list into the build sandbox so %post can see it.
    requirements.txt /opt/requirements.txt

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    # Python 3.12 (Ubuntu 24.04 default), venv + headers, and a compiler in case
    # any wheel needs to build from source.
    apt-get install -y --no-install-recommends \
        python3 python3-venv python3-dev python3-pip \
        build-essential git ca-certificates
    rm -rf /var/lib/apt/lists/*

    # Isolated venv avoids Ubuntu's PEP 668 "externally-managed" restriction and
    # keeps the project deps off the system Python.
    python3 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip
    # torch + the nvidia-*-cu12 wheels in requirements.txt bundle the CUDA 12.8
    # runtime, so no CUDA toolkit is needed in the image -- only --nv at runtime.
    /opt/venv/bin/pip install --no-cache-dir -r /opt/requirements.txt

%environment
    export PATH=/opt/venv/bin:$PATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    # `singularity run --nv torch.sif` launches the federated training entrypoint.
    # Override with `singularity exec --nv torch.sif python3 <other>.py` as needed.
    exec python3 FedEMA_run.py "$@"

%labels
    Description PyTorch 2.9.1 + Flower (CUDA 12.8 via pip wheels) for FedEMA_run.py
